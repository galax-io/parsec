# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# Claude Code local (keep settings.json + hooks tracked; ignore local/secret state)
.claude/settings.local.json
.claude/worktrees/

# spec-kit scratch
scratchpad-*.sh
scratchpad-*.log

# Spec Kit scripts run by Python
__pycache__/

# Spec Kit CLI state: it differs on every machine, and the kit (scripts/check-speckit.sh) leaves it out
.specify/extensions/.registry
.specify/extensions/.cache/
.specify/extensions/.backup/
.specify/presets/.registry
.specify/integrations/*.manifest.json
.specify/workflows/workflow-registry.json

# build output
/bin/
*.test
*.out

# sample Gatling simulation used to record the corpus (sbt project under testdata/)
testdata/corpus/gatling/simulation/target/
testdata/corpus/gatling/simulation/project/target/
testdata/corpus/gatling/simulation/project/project/
testdata/corpus/gatling/simulation/.bsp/
testdata/corpus/gatling/simulation/.metals/
testdata/corpus/gatling/simulation/.bloop/

# Written by setup-speckit.sh; the transcript of an install, not a record of anything.
speckit-install.log

# Spec Kit: Python caches and the CLI state, which the kit does not ship (scripts/check-speckit.sh)
__pycache__/
.specify/extensions/.registry
.specify/extensions/.cache/
.specify/extensions/.backup/
.specify/presets/.registry
.specify/integrations/*.manifest.json
.specify/workflows/workflow-registry.json
