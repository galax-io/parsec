<?xml version="1.0" encoding="UTF-8"?>
<!--
    Logging for the corpus probe.

    This file was scaffolded from the galaxio Gatling template, where it carried nested
    <if>/<then>/<else> blocks driven by CONSOLE_LOGGING, FILE_LOGGING and GRAYLOG_LOGGING
    properties. The probe sets none of them, so every branch was false and the whole
    apparatus resolved to what is written plainly below.

    It is written plainly now because the logback that ships with Gatling 3.13.0 and newer
    cannot parse those blocks: an <else> inside an <if> inside an <if> raises
    EmptyStackException in ElseModelHandler before any appender is created, and the run then
    fails at startup. Simplifying keeps the probe recordable on every version the corpus
    covers, and changes nothing about what is logged on the versions that could parse it.

    Nothing here reaches simulation.log. Gatling writes that itself, and no logging
    configuration changes a byte of it.
-->
<configuration>

    <!-- Discard logback's own config status output. -->
    <statusListener class="ch.qos.logback.core.status.NopStatusListener" />

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%msg%n</pattern>
        </encoder>
    </appender>

    <!-- Picatinny's startup banner and diagnostics. Since picatinny 1.23.0 these arrive
         through SLF4J instead of stdout, and the root level below would swallow them. The
         whole block arrives as one log event, so %msg%n prints it verbatim and keeps the
         ASCII box aligned. On the versions where picatinny is absent this logger simply
         never fires. -->
    <logger name="org.galaxio.gatling.diagnostics" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
    </logger>

    <logger name="io.gatling.http.engine.response.DefaultStatsProcessor" level="WARN"/>

    <!-- No appender: the template attached one only under a property the probe never sets,
         so errors were already going nowhere. Gatling's own console summary is what the
         recording keeps. -->
    <root level="${ROOT_LOGGING_LEVEL:-ERROR}"/>

</configuration>
