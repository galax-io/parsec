<?xml version="1.0" encoding="UTF-8"?>
<!--
  A second build tool for the one corpus simulation, and it exists for exactly one artefact.

  `lastRun.txt` is written by gatling-maven-plugin and by nothing else — not by Gatling, not by the
  Gradle plugin, and the plugin's own gatling:verify goal deletes it again. See
  specs/009-gatling-run-discovery/research.md R1 and R2, which were read from this plugin's
  bytecode. The sbt build beside this file cannot produce one, so the recording under
  testdata/corpus/gatling/lastrun/ is made from here.

  It is deliberately not a second way to record a simulation.log: the sbt build stays the one that
  makes decoder corpus entries, and this compiles the same sources against the same stub so the two
  cannot drift. See testdata/corpus/gatling/lastrun/RECORDING.md for how the recording was taken.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.galaxio.parsec.corpus</groupId>
  <artifactId>corpus</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>17</maven.compiler.release>
    <scala.version>2.13.18</scala.version>
    <!--
      Overridable with -Dgatling.version, like the sbt build — but NOT over the same range, and the
      default deliberately differs from build.sbt's 3.11.5. See the enforcer rule below: this build
      only assembles the scala-plain assertion flavour, so it is restricted to the versions that
      flavour is correct for. build.sbt remains the only way to record a decoder corpus entry.
    -->
    <gatling.version>3.15.1</gatling.version>
    <gatling-maven-plugin.version>4.21.10</gatling-maven-plugin.version>
    <scala-maven-plugin.version>4.9.5</scala-maven-plugin.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.scala-lang</groupId>
      <artifactId>scala-library</artifactId>
      <version>${scala.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.gatling.highcharts</groupId>
      <artifactId>gatling-charts-highcharts</artifactId>
      <version>${gatling.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.gatling</groupId>
      <artifactId>gatling-test-framework</artifactId>
      <version>${gatling.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <testSourceDirectory>src/test/scala</testSourceDirectory>

    <plugins>
      <plugin>
        <groupId>net.alchim31.maven</groupId>
        <artifactId>scala-maven-plugin</artifactId>
        <version>${scala-maven-plugin.version}</version>
        <executions>
          <execution>
            <goals>
              <goal>testCompile</goal>
            </goals>
            <configuration>
              <args>
                <arg>-encoding</arg>
                <arg>UTF-8</arg>
                <arg>-deprecation</arg>
                <arg>-feature</arg>
                <arg>-unchecked</arg>
              </args>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!--
        The assertion flavour, fixed to scala-plain — which is where this build stops being a peer of
        build.sbt and why the enforcer rule below exists.

        build.sbt *chooses* between two flavours: scala-opennfr renders the run's expectations from
        src/test/resources/nfr.yaml and is what the versions through 3.12.x record with, and
        scala-plain states the same expectations in Gatling's own DSL for the versions above, where
        gatling-picatinny has no release. Reproducing that choice here would mean carrying picatinny
        and a profile for a range this build has no reason to enter: it exists to record a
        lastRun.txt, which is a file the build tool writes and has nothing to do with the log format.

        Leaving it unconditional without the version guard would have been the trap — `mvn
        -Dgatling.version=3.12.0 gatling:test` would have been accepted and would have recorded a run
        whose assertions came from a different mechanism than testdata/corpus/gatling/3.12.0/'s,
        while looking like its peer. Spec 005 FR-032 asks for runs that can be compared.
      -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <id>add-assertion-flavour</id>
            <phase>generate-test-sources</phase>
            <goals>
              <goal>add-test-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>src/test/scala-plain</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!--
        Refuse the versions this build cannot record faithfully. Only scala-plain is assembled here
        (see the flavour comment above), and that flavour is the right one from 3.13.0 on; below it
        build.sbt uses scala-opennfr, so a run made here would not be comparable with the corpus
        entry for the same version.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>gatling-version-supported-here</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireProperty>
                  <property>gatling.version</property>
                  <regex>^3\.(1[3-9]|[2-9][0-9])\..*$</regex>
                  <regexMessage>
                    This pom records lastRun.txt only, and assembles the scala-plain assertion
                    flavour, which is correct from Gatling 3.13.0 on. For 3.11.5 or 3.12.x use the
                    sbt build (build.sbt), which selects the scala-opennfr flavour those versions
                    are recorded with.
                  </regexMessage>
                </requireProperty>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>io.gatling</groupId>
        <artifactId>gatling-maven-plugin</artifactId>
        <version>${gatling-maven-plugin.version}</version>
      </plugin>
    </plugins>
  </build>
</project>
